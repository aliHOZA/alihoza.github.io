[
{{- $pages := where .Site.RegularPages "Section" "posts" -}}
{{- range $index, $page := $pages.ByDate.Reverse }}
{{- if $index }},{{ end }}
  {
    "title": {{ $page.Title | jsonify }},
    "url": {{ $page.RelPermalink | jsonify }},
    "date": {{ $page.Date.Format "2006-01-02" | jsonify }},
    "summary": {{ $page.Summary | plainify | htmlUnescape | truncate 190 | jsonify }},
    "readingTime": {{ $page.ReadingTime | jsonify }},
    "number": {{ sub (len $pages) $index | jsonify }},
    "slug": {{ $page.File.ContentBaseName | jsonify }},
    "thumbnail": {{ fileExists (printf "static/images/thumbnails/%s.webp" $page.File.ContentBaseName) | jsonify }},
    "thumbnailUrl": {{ if fileExists (printf "static/images/thumbnails/%s.webp" $page.File.ContentBaseName) }}{{ printf "/images/thumbnails/%s.webp" $page.File.ContentBaseName | relURL | jsonify }}{{ else }}""{{ end }}
  }
{{- end }}
]
