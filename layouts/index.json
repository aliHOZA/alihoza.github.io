[
{{- $pages := where .Site.RegularPages "Section" "posts" -}}
{{- range $index, $page := $pages.ByDate.Reverse }}
{{- if $index }},{{ end }}
  {
    "title": {{ $page.Title | jsonify }},
    "url": {{ $page.RelPermalink | jsonify }},
    "slug": {{ $page.File.ContentBaseName | jsonify }},
    "virgool_id": {{ $page.Params.virgool_id | default "" | jsonify }},
    "original_url": {{ $page.Params.original_url | default "" | jsonify }},
    "date": {{ $page.Date.Format "2006-01-02" | jsonify }},
    "summary": {{ $page.Summary | plainify | htmlUnescape | jsonify }},
    "content": {{ $page.Plain | htmlUnescape | jsonify }},
    "tags": {{ ($page.Params.tags | default (slice)) | jsonify }},
    "categories": {{ ($page.Params.categories | default (slice)) | jsonify }}
  }
{{- end }}
]
